root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 100
# IntelliJ formatter settings that match the ktlint rules detekt runs, so Reformat Code agrees with `check`.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
# For the ktlint IntelliJ plugin; detekt (in `check`) sets its own in config/detekt/detekt.yml.
ktlint_code_style = intellij_idea
